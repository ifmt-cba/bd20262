    "memoEntities": {
      "KYSEFyZ9kJ_0JDST2VK_s": {
        "id": "KYSEFyZ9kJ_0JDST2VK_s",
        "value": "Controle de manutenção de equipamentos de laboratório.\n\nÉ preciso registrar salas, equipamentos e sua lotação nos espaços físicos.\nFaz-se necessário também poder fazer um controle de manutenção desses equipamentos.\nÉ importante poder saber quem fez a manutenção e a lotação do equipamento para fins de auditoria.\nPor fim é necessário que um equipamento possa ser desativado, ficando lotado em um setor específico para isso.\n",
        "ui": {
          "x": 34,
          "y": 19,
          "zIndex": 2,
          "width": 635,
          "height": 100,
          "color": ""
        },
        "meta": {
          "updateAt": 1786469931814,
          "createAt": 1786469856842
        }
      }
    }
  }
